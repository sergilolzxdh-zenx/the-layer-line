---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

const tools = [
  {
    title: 'Filament & Print Cost Calculator',
    href: '/tools/filament-cost-calculator/',
    description:
      'Enter your spool price, print weight, print time, and electricity rate to get a real per-print cost, with an optional allowance for failed prints.',
  },
  {
    title: 'Print Problem Diagnostic',
    href: '/tools/print-problem-diagnostic/',
    description:
      'Pick the defect you’re seeing and get the most likely causes in priority order, each linked to a full troubleshooting guide.',
  },
];
---

<BaseLayout
  title="3D Printing Tools"
  description="Interactive calculators and diagnostic tools for desktop FDM 3D printing."
  path="/tools/"
>
  <div class="container tools-hub">
    <Breadcrumbs crumbs={[{ label: 'Home', href: '/' }, { label: 'Tools', href: '/tools/' }]} />
    <header class="tools-hub__header">
      <h1>3D Printing Tools</h1>
      <p class="tools-hub__lead">
        Small, focused tools that solve a specific problem — not a dashboard of everything we could think of.
      </p>
      <div class="layer-lines" aria-hidden="true"><span></span><span></span><span></span></div>
    </header>

    <div class="tools-hub__grid">
      {
        tools.map((tool, index) => (
          <a class="tool-card" href={tool.href} data-reveal style={`--reveal-index:${index}`}>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <span class="tool-card__cta">
              Open tool
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
            </span>
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  .tools-hub {
    padding-block: var(--space-6) var(--space-9);
  }

  .tools-hub__header {
    max-width: var(--measure-wide);
    margin-top: var(--space-5);
  }

  .tools-hub__header h1 {
    font-size: var(--size-5);
    margin-top: var(--space-3);
  }

  .tools-hub__lead {
    font-size: var(--size-2);
    color: var(--color-ink-soft);
    margin-top: var(--space-3);
  }

  .tools-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .tool-card {
    display: block;
    padding: var(--space-6);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg-raised);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .tool-card:nth-child(2) {
    border-top-color: var(--color-accent-cool);
  }

  .tool-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .tool-card h2 {
    font-size: var(--size-3);
    margin-bottom: var(--space-3);
  }

  .tool-card p {
    color: var(--color-ink-soft);
  }

  .tool-card__cta {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    color: var(--color-accent-cool);
  }

  .tool-card__cta svg {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .tool-card:hover .tool-card__cta svg {
    transform: translateX(3px);
  }
</style>
