---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CATEGORIES, CATEGORY_ORDER } from '../lib/categories';
import { GLOSSARY_TERMS } from '../lib/glossary-terms';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const typeLabels: Record<string, string> = {
  guide: 'Guide',
  'how-to': 'How-to',
  troubleshooting: 'Troubleshooting',
  comparison: 'Comparison',
  reference: 'Reference',
};

const editorsPickSlugs = ['print-quality/stringing', 'print-quality/warping', 'calibration/retraction-tuning'];
const editorsPicks = editorsPickSlugs
  .map((slug) => allArticles.find((a: CollectionEntry<'articles'>) => a.id === slug))
  .filter((a): a is CollectionEntry<'articles'> => Boolean(a));

const byCategory = CATEGORY_ORDER.map((slug) => ({
  slug,
  meta: CATEGORIES[slug],
  articles: allArticles.filter((a: CollectionEntry<'articles'>) => a.data.category === slug),
}));

const stats = {
  guides: allArticles.length,
  terms: GLOSSARY_TERMS.length,
  calibrations: allArticles.filter((a) => a.data.category === 'calibration').length,
};

const defects = [
  {
    code: 'D-01',
    title: 'Stringing',
    description: 'Thin threads between features, left behind on travel moves.',
    href: '/print-quality/stringing/',
    lever: 'retraction',
  },
  {
    code: 'D-02',
    title: 'Warping',
    description: 'Corners lifting off the bed as the outer plastic cools first.',
    href: '/print-quality/warping/',
    lever: 'bed adhesion',
  },
  {
    code: 'D-03',
    title: 'Layer lines & ringing',
    description: 'Visible ridges, or repeating bands from gantry flex.',
    href: '/print-quality/layer-lines/',
    lever: 'vibration',
  },
  {
    code: 'D-04',
    title: 'Under- & over-extrusion',
    description: 'Gaps and weak walls, or blobby, smeared surfaces.',
    href: '/print-quality/under-extrusion-vs-over-extrusion/',
    lever: 'flow rate',
  },
  {
    code: 'D-05',
    title: 'Weak first layer',
    description: "Poor adhesion or gaps before the print even gets going.",
    href: '/print-quality/first-layer-adhesion/',
    lever: 'z-offset',
  },
];

const pillarIcons: Record<string, string> = {
  'print-quality':
    '<path d="M10.29 3.86 1.82 18a1.5 1.5 0 0 0 1.29 2.25h17.78A1.5 1.5 0 0 0 22.18 18L13.71 3.86a1.5 1.5 0 0 0-2.42 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  calibration:
    '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/>',
  materials:
    '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
};
---

<BaseLayout
  title="Practical FDM 3D Printing Guides & Calculators"
  description="Independent guides, calibration walkthroughs and calculators for desktop FDM 3D printing — stringing, warping, layer lines, retraction, and the settings behind them."
  path="/"
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Field diagnosis</p>
        <h1>Your print is failing. Point at the symptom.</h1>
        <p class="hero__lead">
          Pick what you're seeing on the bed. You'll get the mechanism behind it, the likely cause, and the setting
          to check first — not lifestyle padding around an affiliate link.
        </p>
        <div class="hero__actions">
          <a class="button button--accent" href="/tools/print-problem-diagnostic/">Start a diagnosis →</a>
          <a class="button" href="/print-quality/">Browse every defect</a>
        </div>
        <dl class="hero__stats">
          <div class="hero__stat">
            <dt>Guides</dt>
            <dd>{stats.guides}</dd>
          </div>
          <div class="hero__stat">
            <dt>Glossary terms</dt>
            <dd>{stats.terms}</dd>
          </div>
          <div class="hero__stat">
            <dt>Calibrations</dt>
            <dd>{stats.calibrations}</dd>
          </div>
        </dl>
      </div>

      <div class="defect-table">
        <div class="defect-table__head">
          <p class="label">Browse by defect</p>
          <span class="defect-table__count">{defects.length} entries</span>
        </div>
        <ul class="defect-table__list">
          {
            defects.map((d) => (
              <li>
                <a class="defect-row" href={d.href}>
                  <span class="defect-row__code">{d.code}</span>
                  <span class="defect-row__text">
                    <span class="defect-row__title">{d.title}</span>
                    <span class="defect-row__desc">{d.description}</span>
                  </span>
                  <span class="defect-row__lever">
                    {d.lever}
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m13 6 6 6-6 6" /></svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Three pillars, everything else hangs off them</h2>
      <div class="pillars-list">
        {
          byCategory.map(({ slug, meta }, index) => (
            <a class:list={['pillar-row', { 'pillar-row--start': index === 0 }]} href={`/${slug}/`} data-reveal style={`--reveal-index:${index}`}>
              <svg class="pillar-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pillarIcons[slug]} />
              <div class="pillar-row__text">
                <h3>
                  {meta.title}
                  {index === 0 && <span class="pillar-row__badge">Start here</span>}
                </h3>
                <p>{meta.description}</p>
              </div>
              <span class="pillar-row__cta">
                Read the guide
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <div class="section__head">
        <h2>Where most people start</h2>
        <a class="section__all" href="/print-quality/">All {stats.guides} guides →</a>
      </div>
      <div class="spotlight-grid">
        {
          editorsPicks.map((article, index) => (
            <a class="spotlight-card" href={`/${article.id}/`} data-reveal style={`--reveal-index:${index}`}>
              <div class="spotlight-card__visual" data-tone={index === 1 ? 'accent' : 'ink'}>
                <span class="spotlight-card__code">{CATEGORIES[article.data.category].short}</span>
              </div>
              <div class="spotlight-card__body">
                <p class="spotlight-card__meta">{typeLabels[article.data.pageType]}</p>
                <h3>{article.data.title}</h3>
                <p>{article.data.description}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Reference & tools</h2>
      <div class="tools-grid">
        <a class="tools-card" href="/glossary/" data-reveal style="--reveal-index:0">
          <h3>Glossary</h3>
          <p>Searchable, plain-language definitions for every value you'll be asked to change.</p>
          <span class="tools-card__cta">{stats.terms} terms →</span>
        </a>
        <a class="tools-card" href="/tools/filament-cost-calculator/" data-reveal style="--reveal-index:1">
          <h3>Filament & print cost calculator</h3>
          <p>Filament, electricity, and failed-print allowance, on an instrument readout.</p>
          <span class="tools-card__cta">Open the calculator →</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container browse">
      <h2>All guides by topic</h2>
      <div class="browse-grid">
        {
          byCategory.map(({ slug, meta, articles }) => (
            <div class="browse-column">
              <h3><a href={`/${slug}/`}>{meta.short}</a></h3>
              <ul>
                {articles.map((article: CollectionEntry<'articles'>) => (
                  <li><a href={`/${article.id}/`}>{article.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="browse-column">
          <h3><a href="/glossary/">Reference</a></h3>
          <ul>
            <li><a href="/glossary/">3D Printing Glossary</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-teaser">
      <div>
        <h2>Independently written. No sponsored recommendations.</h2>
        <p>
          The Layer Line isn't affiliated with any printer or filament manufacturer. Guides are built from
          well-established engineering principles behind FDM printing, cross-checked against manufacturer
          documentation where it exists. See the <a href="/editorial-policy/">editorial policy</a> for how we work,
          or <a href="/about/">the about page</a> for more on why this site exists.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: var(--border-hair);
    padding-block: var(--space-8) var(--space-9);
    overflow: clip;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: start;
  }

  .hero__text {
    animation: hero-in var(--duration-slow) var(--ease-out) both;
  }

  .defect-table {
    animation: hero-in var(--duration-slow) var(--ease-out) 90ms both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__text,
    .defect-table {
      animation: none;
    }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: var(--size-00);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: var(--space-3);
  }

  .hero__text h1 {
    font-size: var(--size-6);
    max-width: 15ch;
  }

  .hero__lead {
    font-size: var(--size-2);
    color: var(--color-ink-soft);
    max-width: 44ch;
    margin-top: var(--space-4);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .hero__stats {
    display: flex;
    gap: 0;
    margin: var(--space-7) 0 0;
    border: var(--border-hair);
    border-radius: var(--radius-md);
    max-width: 32rem;
  }

  .hero__stat {
    flex: 1;
    display: flex;
    flex-direction: column-reverse;
    padding: var(--space-4);
    text-align: center;
  }

  .hero__stat + .hero__stat {
    border-left: var(--border-hair);
  }

  .hero__stat dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--size-4);
    font-weight: 600;
    color: var(--color-ink);
  }

  .hero__stat dt {
    font-size: var(--size-000);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin-top: var(--space-1);
  }

  .defect-table {
    border: var(--border-hair-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
  }

  .defect-table__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--border-hair);
  }

  .defect-table__count {
    font-family: var(--font-mono);
    font-size: var(--size-00);
    color: var(--color-ink-faint);
  }

  .defect-table__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .defect-row {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-5);
    text-decoration: none;
    color: var(--color-ink);
    border-top: var(--border-hair);
    transition: background var(--duration-fast) var(--ease-out);
  }

  .defect-table__list li:first-child .defect-row {
    border-top: none;
  }

  .defect-row:hover {
    background: var(--color-bg-sunken);
  }

  .defect-row__code {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--size-00);
    color: var(--color-ink-faint);
  }

  .defect-row__text {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .defect-row__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: var(--size-1);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .defect-row:hover .defect-row__title {
    color: var(--color-accent);
  }

  .defect-row__desc {
    font-size: var(--size-00);
    color: var(--color-ink-soft);
  }

  .defect-row__lever {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-family: var(--font-mono);
    font-size: var(--size-00);
    color: var(--color-accent-cool);
    white-space: nowrap;
  }

  .defect-row__lever svg {
    width: 14px;
    height: 14px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .defect-row:hover .defect-row__lever svg {
    transform: translateX(3px);
  }

  .section {
    padding-block: var(--space-9);
  }

  .section--sunken {
    background: var(--color-bg-sunken);
  }

  .section h2 {
    font-size: var(--size-4);
    max-width: 28ch;
  }

  .section__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    flex-wrap: wrap;
  }

  .section__all {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    color: var(--color-accent-cool);
    text-decoration: none;
    white-space: nowrap;
  }

  .section__all:hover {
    color: var(--color-accent);
  }

  .pillars-list {
    margin-top: var(--space-6);
  }

  .pillar-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: var(--border-hair);
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillars-list a:last-child {
    border-bottom: var(--border-hair);
  }

  .pillar-row--start {
    padding-block: var(--space-7);
  }

  .pillar-row__icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    color: var(--color-accent-cool);
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .pillar-row--start .pillar-row__icon {
    width: 44px;
    height: 44px;
  }

  .pillar-row:hover .pillar-row__icon {
    color: var(--color-accent);
    transform: scale(1.08);
  }

  .pillar-row__text {
    flex: 1;
    min-width: 0;
  }

  .pillar-row__text h3 {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-3);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .pillar-row--start .pillar-row__text h3 {
    font-size: var(--size-4);
  }

  .pillar-row__badge {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-000);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
  }

  .pillar-row:hover .pillar-row__text h3 {
    color: var(--color-accent);
  }

  .pillar-row__text p {
    color: var(--color-ink-soft);
    margin: var(--space-2) 0 0;
    max-width: 56ch;
  }

  .pillar-row__cta {
    flex-shrink: 0;
    display: none;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    color: var(--color-accent-cool);
  }

  .pillar-row__cta svg {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .pillar-row:hover .pillar-row__cta svg {
    transform: translateX(3px);
  }

  .spotlight-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .spotlight-card {
    display: block;
    text-decoration: none;
    color: var(--color-ink);
    background: var(--color-bg-raised);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .spotlight-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .spotlight-card__visual {
    aspect-ratio: 16 / 9;
    display: flex;
    align-items: flex-end;
    padding: var(--space-4);
    background: var(--color-ink);
    background-image: repeating-linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.07) 0px,
      rgba(255, 255, 255, 0.07) 2px,
      transparent 2px,
      transparent 16px
    );
  }

  .spotlight-card__visual[data-tone='accent'] {
    background-color: var(--color-accent);
    background-image: repeating-linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0px,
      rgba(0, 0, 0, 0.1) 2px,
      transparent 2px,
      transparent 16px
    );
  }

  .spotlight-card__code {
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--size-3);
    letter-spacing: 0.04em;
    color: rgba(255, 255, 255, 0.85);
  }

  .spotlight-card__body {
    padding: var(--space-5);
  }

  .spotlight-card__meta {
    font-family: var(--font-mono);
    font-size: var(--size-000);
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    margin: 0;
  }

  .spotlight-card__body h3 {
    font-size: var(--size-2);
    margin-top: var(--space-2);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .spotlight-card:hover .spotlight-card__body h3 {
    color: var(--color-accent);
  }

  .spotlight-card__body p {
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    margin: var(--space-2) 0 0;
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .tools-card {
    display: block;
    padding: var(--space-6);
    border: var(--border-hair-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .tools-card:hover {
    border-color: var(--color-ink);
    transform: translateY(-2px);
  }

  .tools-card h3 {
    font-size: var(--size-2);
    margin-bottom: var(--space-2);
  }

  .tools-card p {
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    margin: 0;
  }

  .tools-card__cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--size-00);
    color: var(--color-accent-cool);
  }

  .browse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .browse-column h3 {
    font-size: var(--size-1);
  }

  .browse-column h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .browse-column ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .browse-column a {
    font-size: var(--size-0);
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .browse-column a:hover {
    color: var(--color-accent);
  }

  .about-teaser p {
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .pillar-row__cta {
      display: inline-flex;
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .browse-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .spotlight-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .browse-grid {
      grid-template-columns: 1fr;
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }

    .pillar-row {
      flex-wrap: wrap;
    }

    .hero__stats {
      max-width: none;
    }

    .defect-row {
