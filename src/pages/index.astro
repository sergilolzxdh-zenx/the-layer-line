---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CATEGORIES, CATEGORY_ORDER } from '../lib/categories';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const editorsPickSlugs = [
  'print-quality/stringing',
  'calibration/retraction-tuning',
  'materials/petg-guide',
  'print-quality/warping',
];
const editorsPicks = editorsPickSlugs
  .map((slug) => allArticles.find((a: CollectionEntry<'articles'>) => a.id === slug))
  .filter((a): a is CollectionEntry<'articles'> => Boolean(a));

const byCategory = CATEGORY_ORDER.map((slug) => ({
  slug,
  meta: CATEGORIES[slug],
  articles: allArticles.filter((a: CollectionEntry<'articles'>) => a.data.category === slug),
}));
---

<BaseLayout
  title="Practical FDM 3D Printing Guides & Calculators"
  description="Independent guides, calibration walkthroughs and calculators for desktop FDM 3D printing — stringing, warping, layer lines, retraction, and the settings behind them."
  path="/"
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="eyebrow">Desktop FDM 3D printing</p>
        <h1>Every print defect is a symptom. This is how you find the cause.</h1>
        <p class="hero__lead">
          Practical, mechanism-first guides for the problems that actually show up on desktop printers — stringing,
          warping, layer lines, weak first layers — plus the calibration steps that prevent most of them.
        </p>
        <div class="hero__actions">
          <a class="button button--accent" href="/print-quality/">Start with print quality</a>
          <a class="button" href="/tools/print-problem-diagnostic/">Diagnose a print →</a>
        </div>
      </div>
      <div class="hero__diagram" aria-hidden="false">
        <svg viewBox="0 0 620 420" role="img" aria-labelledby="hero-diagram-title">
          <title id="hero-diagram-title">A diagram of a print showing stringing, a warped corner, and layer banding</title>
          <line x1="20" y1="380" x2="600" y2="380" stroke="#9aa197" stroke-width="2" />
          {Array.from({ length: 30 }).map((_, i) => (
            <line x1={20 + i * 20} y1="380" x2={20 + i * 20} y2="386" stroke="#9aa197" stroke-width="1" />
          ))}

          <g>
            <rect x="70" y="270" width="60" height="110" fill="none" stroke="#1b1f1d" stroke-width="2" />
            <line x1="70" y1="290" x2="130" y2="290" stroke="#c7cdc3" stroke-width="1" />
            <line x1="70" y1="310" x2="130" y2="310" stroke="#c7cdc3" stroke-width="1" />
            <line x1="70" y1="330" x2="130" y2="330" stroke="#c7cdc3" stroke-width="1" />
            <line x1="70" y1="350" x2="130" y2="350" stroke="#c7cdc3" stroke-width="1" />
            <rect x="200" y="290" width="60" height="90" fill="none" stroke="#1b1f1d" stroke-width="2" />
            <path d="M130 285 Q 165 250 200 292" fill="none" stroke="#e8582a" stroke-width="1.5" />
            <path d="M130 300 Q 165 270 200 305" fill="none" stroke="#e8582a" stroke-width="1.5" />
            <a href="/print-quality/stringing/">
              <circle cx="165" cy="272" r="5" fill="#e8582a" />
              <text x="165" y="255" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" fill="#4a5049">STRINGING</text>
            </a>
          </g>

          <g>
            <path d="M330 380 L330 300 Q328 275 350 278 L 430 285 L 430 380 Z" fill="none" stroke="#1b1f1d" stroke-width="2" />
            <line x1="330" y1="360" x2="330" y2="380" stroke="#e8582a" stroke-width="2" stroke-dasharray="4 3" />
            <a href="/print-quality/warping/">
              <circle cx="335" cy="292" r="5" fill="#e8582a" />
              <text x="360" y="250" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" fill="#4a5049">WARPING</text>
            </a>
          </g>

          <g>
            <rect x="480" y="230" width="90" height="150" fill="none" stroke="#1b1f1d" stroke-width="2" />
            {Array.from({ length: 13 }).map((_, i) => (
              <line x1="480" y1={240 + i * 11} x2="570" y2={240 + i * 11 + (i % 2 === 0 ? 3 : -3)} stroke="#215b66" stroke-width="1" />
            ))}
            <a href="/print-quality/layer-lines/">
              <circle cx="525" cy="222" r="5" fill="#215b66" />
              <text x="525" y="205" text-anchor="middle" font-family="IBM Plex Mono, monospace" font-size="13" fill="#4a5049">RINGING</text>
            </a>
          </g>
        </svg>
        <p class="hero__diagram-caption">Three real defects, three different root causes. Click one.</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Where to start</p>
      <h2>Three pillars, everything else hangs off them</h2>
      <div class="pillars-grid">
        {
          byCategory.map(({ slug, meta }) => (
            <a class="pillar-card" href={`/${slug}/`}>
              <h3>{meta.title}</h3>
              <p>{meta.description}</p>
              <span class="pillar-card__cta">Read the guide →</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <p class="eyebrow">Editor's picks</p>
      <h2>Where most people start</h2>
      <div class="picks-grid">
        {
          editorsPicks.map((article) => (
            <a class="pick-card" href={`/${article.id}/`}>
              <p class="pick-card__cat">{CATEGORIES[article.data.category].short}</p>
              <h3>{article.data.title}</h3>
              <p>{article.data.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="eyebrow">Tools</p>
      <h2>Calculators worth bookmarking</h2>
      <div class="tools-grid">
        <a class="tools-card" href="/tools/filament-cost-calculator/">
          <h3>Filament & Print Cost Calculator</h3>
          <p>Real per-print cost from your spool price, print time, and electricity rate.</p>
        </a>
        <a class="tools-card" href="/tools/print-problem-diagnostic/">
          <h3>Print Problem Diagnostic</h3>
          <p>Pick the defect you're seeing, get the most likely causes in priority order.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container browse">
      <p class="eyebrow">Browse everything</p>
      <h2>All guides by topic</h2>
      <div class="browse-grid">
        {
          byCategory.map(({ slug, meta, articles }) => (
            <div class="browse-column">
              <h3><a href={`/${slug}/`}>{meta.short}</a></h3>
              <ul>
                {articles.map((article: CollectionEntry<'articles'>) => (
                  <li><a href={`/${article.id}/`}>{article.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="browse-column">
          <h3><a href="/glossary/">Reference</a></h3>
          <ul>
            <li><a href="/glossary/">3D Printing Glossary</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-teaser">
      <div>
        <p class="eyebrow">About this site</p>
        <h2>Independently written. No sponsored recommendations.</h2>
        <p>
          The Layer Line isn't affiliated with any printer or filament manufacturer. Guides are built from
          well-established engineering principles behind FDM printing, cross-checked against manufacturer
          documentation where it exists. See the <a href="/editorial-policy/">editorial policy</a> for how we work,
          or <a href="/about/">the about page</a> for more on why this site exists.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    border-bottom: var(--border-hair);
    padding-block: var(--space-8) var(--space-9);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__text h1 {
    font-size: var(--size-6);
    margin-top: var(--space-3);
    max-width: 16ch;
  }

  .hero__lead {
    font-size: var(--size-2);
    color: var(--color-ink-soft);
    max-width: 46ch;
    margin-top: var(--space-4);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .hero__diagram svg {
    width: 100%;
    height: auto;
  }

  .hero__diagram a circle {
    transition: r var(--duration-fast) var(--ease-standard);
  }

  .hero__diagram a:hover circle {
    r: 7;
  }

  .hero__diagram-caption {
    text-align: center;
    font-family: var(--font-mono);
    font-size: var(--size-000);
    color: var(--color-ink-faint);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    margin-top: var(--space-2);
  }

  .section {
    padding-block: var(--space-9);
  }

  .section--sunken {
    background: var(--color-bg-sunken);
  }

  .section h2 {
    font-size: var(--size-4);
    margin-top: var(--space-2);
    max-width: 28ch;
  }

  .pillars-grid,
  .picks-grid,
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .picks-grid {
    grid-template-columns: repeat(4, 1fr);
  }

  .tools-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .pillar-card,
  .pick-card,
  .tools-card {
    display: block;
    padding: var(--space-5);
    border: var(--border-hair);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillar-card:hover,
  .pick-card:hover,
  .tools-card:hover {
    border-color: var(--color-accent);
  }

  .pillar-card h3,
  .pick-card h3,
  .tools-card h3 {
    font-size: var(--size-2);
    margin-bottom: var(--space-2);
  }

  .pillar-card p,
  .pick-card p,
  .tools-card p {
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    margin: 0;
  }

  .pillar-card__cta {
    display: inline-block;
    margin-top: var(--space-3);
    font-family: var(--font-mono);
    font-size: var(--size-000);
    text-transform: uppercase;
    color: var(--color-accent-cool);
  }

  .pick-card__cat {
    font-family: var(--font-mono);
    font-size: var(--size-000);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent-cool);
    margin: 0 0 var(--space-2);
  }

  .browse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .browse-column h3 {
    font-size: var(--size-1);
  }

  .browse-column h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .browse-column ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .browse-column a {
    font-size: var(--size-0);
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .browse-column a:hover {
    color: var(--color-accent);
  }

  .about-teaser p {
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-top: var(--space-4);
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .pillars-grid,
    .picks-grid,
    .browse-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .pillars-grid,
    .picks-grid,
    .browse-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
