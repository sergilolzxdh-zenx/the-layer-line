---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection, type CollectionEntry } from 'astro:content';
import { CATEGORIES, CATEGORY_ORDER } from '../lib/categories';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);

const editorsPickSlugs = [
  'print-quality/stringing',
  'calibration/retraction-tuning',
  'materials/petg-guide',
  'print-quality/warping',
];
const editorsPicks = editorsPickSlugs
  .map((slug) => allArticles.find((a: CollectionEntry<'articles'>) => a.id === slug))
  .filter((a): a is CollectionEntry<'articles'> => Boolean(a));

const byCategory = CATEGORY_ORDER.map((slug) => ({
  slug,
  meta: CATEGORIES[slug],
  articles: allArticles.filter((a: CollectionEntry<'articles'>) => a.data.category === slug),
}));

const pillarIcons: Record<string, string> = {
  'print-quality':
    '<path d="M10.29 3.86 1.82 18a1.5 1.5 0 0 0 1.29 2.25h17.78A1.5 1.5 0 0 0 22.18 18L13.71 3.86a1.5 1.5 0 0 0-2.42 0Z"/><path d="M12 9v4"/><path d="M12 17h.01"/>',
  calibration:
    '<path d="M4 21v-7"/><path d="M4 10V3"/><path d="M12 21v-9"/><path d="M12 8V3"/><path d="M20 21v-5"/><path d="M20 12V3"/><path d="M1 14h6"/><path d="M9 8h6"/><path d="M17 16h6"/>',
  materials:
    '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
};

const toolIcons = {
  calculator:
    '<rect x="4" y="2" width="16" height="20" rx="2"/><line x1="8" y1="6" x2="16" y2="6"/><line x1="8" y1="11" x2="8" y2="11.01"/><line x1="12" y1="11" x2="12" y2="11.01"/><line x1="16" y1="11" x2="16" y2="11.01"/><line x1="8" y1="15" x2="8" y2="15.01"/><line x1="12" y1="15" x2="12" y2="15.01"/><line x1="16" y1="15" x2="16" y2="15.01"/><line x1="8" y1="19" x2="16" y2="19"/>',
  diagnostic:
    '<circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><path d="M11 8v3l2 2"/>',
};

const SYMPTOMS = [
  {
    label: 'Thin hairs between parts',
    cause: 'Wet filament or the nozzle running too hot',
    fix: "Dry the spool first, then drop nozzle temperature in 5°C steps. Retraction is the third thing to check, not the first.",
    href: '/print-quality/stringing/',
  },
  {
    label: 'Corners lifting off the bed',
    cause: 'Bed too cool, or a draft across the plate',
    fix: "Raise bed temperature and clean the plate before touching anything else — most warping isn't a settings problem.",
    href: '/print-quality/warping/',
  },
  {
    label: 'Gaps or weak top layers',
    cause: 'Under-extrusion — not enough plastic',
    fix: 'Check flow rate with a single-wall test before adding more top layers to paper over the problem.',
    href: '/print-quality/under-extrusion-vs-over-extrusion/',
  },
  {
    label: 'Rippling after every corner',
    cause: 'Ringing from vibration, not heat',
    fix: "Tension the belts and reduce acceleration — temperature and cooling settings won't touch this.",
    href: '/print-quality/layer-lines/',
  },
];
---

<BaseLayout
  title="Practical FDM 3D Printing Guides & Calculators"
  description="Independent guides, calibration walkthroughs and calculators for desktop FDM 3D printing — stringing, warping, layer lines, retraction, and the settings behind them."
  path="/"
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1>Every print defect is a symptom. This is how you find the cause.</h1>
        <p class="hero__lead">
          Practical, mechanism-first guides for the problems that actually show up on desktop printers — stringing,
          warping, layer lines, weak first layers — plus the calibration steps that prevent most of them.
        </p>
        <div class="hero__actions">
          <a class="button button--accent" href="/print-quality/">Start with print quality</a>
          <a class="button" href="/tools/print-problem-diagnostic/">Diagnose a print →</a>
        </div>
      </div>
      <div class="triage" data-reveal>
        <div class="triage__head">
          <p class="label">Quick triage</p>
          <span class="triage__count">{SYMPTOMS.length} symptoms</span>
        </div>
        <div class="triage__buttons" role="group" aria-label="Pick what you're seeing">
          {
            SYMPTOMS.map((s, i) => (
              <button type="button" class="triage__btn" data-index={i} aria-pressed={i === 0 ? 'true' : 'false'}>
                {s.label}
              </button>
            ))
          }
        </div>
        <div class="triage__result">
          <p class="label">Most likely cause</p>
          <p class="triage__cause" id="triage-cause">{SYMPTOMS[0].cause}</p>
          <p class="triage__fix" id="triage-fix">{SYMPTOMS[0].fix}</p>
          <a class="triage__link" id="triage-link" href={SYMPTOMS[0].href}>
            Open the full guide →
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Three pillars, everything else hangs off them</h2>
      <div class="pillars-list">
        {
          byCategory.map(({ slug, meta }, index) => (
            <a class:list={['pillar-row', { 'pillar-row--start': index === 0 }]} href={`/${slug}/`} data-reveal style={`--reveal-index:${index}`}>
              <svg class="pillar-row__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pillarIcons[slug]} />
              <div class="pillar-row__text">
                <h3>
                  {meta.title}
                  {index === 0 && <span class="pillar-row__badge">Start here</span>}
                </h3>
                <p>{meta.description}</p>
              </div>
              <span class="pillar-row__cta">
                Read the guide
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m13 6 6 6-6 6"/></svg>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container">
      <h2>Where most people start</h2>
      <div class="picks-list" data-reveal>
        {editorsPicks.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Calculators worth bookmarking</h2>
      <div class="tools-grid">
        <a class="tools-card" href="/tools/filament-cost-calculator/" data-reveal style="--reveal-index:0">
          <svg class="tools-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={toolIcons.calculator} />
          <h3>Filament & Print Cost Calculator</h3>
          <p>Real per-print cost from your spool price, print time, and electricity rate.</p>
        </a>
        <a class="tools-card" href="/tools/print-problem-diagnostic/" data-reveal style="--reveal-index:1">
          <svg class="tools-card__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={toolIcons.diagnostic} />
          <h3>Print Problem Diagnostic</h3>
          <p>Pick the defect you're seeing, get the most likely causes in priority order.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--sunken">
    <div class="container browse">
      <h2>All guides by topic</h2>
      <div class="browse-grid">
        {
          byCategory.map(({ slug, meta, articles }) => (
            <div class="browse-column">
              <h3><a href={`/${slug}/`}>{meta.short}</a></h3>
              <ul>
                {articles.map((article: CollectionEntry<'articles'>) => (
                  <li><a href={`/${article.id}/`}>{article.data.title}</a></li>
                ))}
              </ul>
            </div>
          ))
        }
        <div class="browse-column">
          <h3><a href="/glossary/">Reference</a></h3>
          <ul>
            <li><a href="/glossary/">3D Printing Glossary</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container about-teaser">
      <div>
        <h2>Independently written. No sponsored recommendations.</h2>
        <p>
          The Layer Line isn't affiliated with any printer or filament manufacturer. Guides are built from
          well-established engineering principles behind FDM printing, cross-checked against manufacturer
          documentation where it exists. See the <a href="/editorial-policy/">editorial policy</a> for how we work,
          or <a href="/about/">the about page</a> for more on why this site exists.
        </p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <Newsletter />
    </div>
  </section>
</BaseLayout>

<script>
  const SYMPTOMS = [
    {
      cause: 'Wet filament or the nozzle running too hot',
      fix: "Dry the spool first, then drop nozzle temperature in 5°C steps. Retraction is the third thing to check, not the first.",
      href: '/print-quality/stringing/',
    },
    {
      cause: 'Bed too cool, or a draft across the plate',
      fix: "Raise bed temperature and clean the plate before touching anything else — most warping isn't a settings problem.",
      href: '/print-quality/warping/',
    },
    {
      cause: 'Under-extrusion — not enough plastic',
      fix: 'Check flow rate with a single-wall test before adding more top layers to paper over the problem.',
      href: '/print-quality/under-extrusion-vs-over-extrusion/',
    },
    {
      cause: 'Ringing from vibration, not heat',
      fix: "Tension the belts and reduce acceleration — temperature and cooling settings won't touch this.",
      href: '/print-quality/layer-lines/',
    },
  ];

  function setupTriage() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.triage__btn');
    const causeEl = document.getElementById('triage-cause');
    const fixEl = document.getElementById('triage-fix');
    const linkEl = document.getElementById('triage-link') as HTMLAnchorElement | null;
    if (!buttons.length || !causeEl || !fixEl || !linkEl) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.index);
        const symptom = SYMPTOMS[index];
        if (!symptom) return;

        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        causeEl.textContent = symptom.cause;
        fixEl.textContent = symptom.fix;
        linkEl.href = symptom.href;
      });
    });
  }

  document.addEventListener('astro:page-load', setupTriage);
</script>

<style>
  .hero {
    border-bottom: var(--border-hair);
    padding-block: var(--space-8) var(--space-9);
    overflow: clip;
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8);
    align-items: center;
  }

  .hero__text {
    animation: hero-in var(--duration-slow) var(--ease-out) both;
  }

  .triage {
    animation: hero-in var(--duration-slow) var(--ease-out) 90ms both;
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__text,
    .triage {
      animation: none;
    }
  }

  .hero__text h1 {
    font-size: var(--size-6);
    max-width: 16ch;
  }

  .hero__lead {
    font-size: var(--size-2);
    color: var(--color-ink-soft);
    max-width: 46ch;
    margin-top: var(--space-4);
  }

  .hero__actions {
    display: flex;
    gap: var(--space-4);
    margin-top: var(--space-6);
    flex-wrap: wrap;
  }

  .triage {
    border: var(--border-hair-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-raised);
    overflow: hidden;
  }

  .triage__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: var(--space-4) var(--space-5);
    border-bottom: var(--border-hair);
  }

  .triage__count {
    font-family: var(--font-mono);
    font-size: var(--size-00);
    color: var(--color-ink-faint);
  }

  .triage__buttons {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-4) var(--space-5);
  }

  .triage__btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: var(--space-3) var(--space-4);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-0);
    color: var(--color-ink-soft);
    background: none;
    border: var(--border-hair);
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: border-color var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out), background var(--duration-fast) var(--ease-out), transform var(--duration-instant) var(--ease-out);
  }

  .triage__btn:hover {
    border-color: var(--color-ink);
    color: var(--color-ink);
  }

  .triage__btn:active {
    transform: scale(var(--scale-press));
  }

  .triage__btn[aria-pressed='true'] {
    border-color: var(--color-accent);
    background: var(--color-accent-cool-soft);
    color: var(--color-ink);
  }

  .triage__result {
    padding: var(--space-5);
    border-top: var(--border-hair);
    background: var(--color-bg-sunken);
  }

  .triage__cause {
    margin-top: var(--space-2);
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: var(--size-2);
    color: var(--color-accent-cool);
  }

  .triage__fix {
    margin-top: var(--space-2);
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    line-height: var(--leading-relaxed);
  }

  .triage__link {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--size-00);
    color: var(--color-accent);
  }

  .section {
    padding-block: var(--space-9);
  }

  .section--sunken {
    background: var(--color-bg-sunken);
  }

  .section h2 {
    font-size: var(--size-4);
    max-width: 28ch;
  }

  .pillars-list {
    margin-top: var(--space-6);
  }

  .pillar-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-6);
    border-top: var(--border-hair);
    text-decoration: none;
    color: var(--color-ink);
  }

  .pillars-list a:last-child {
    border-bottom: var(--border-hair);
  }

  .pillar-row--start {
    padding-block: var(--space-7);
  }

  .pillar-row__icon {
    flex-shrink: 0;
    width: 34px;
    height: 34px;
    color: var(--color-accent-cool);
    transition: color var(--duration-fast) var(--ease-out), transform var(--duration-base) var(--ease-out);
  }

  .pillar-row--start .pillar-row__icon {
    width: 44px;
    height: 44px;
  }

  .pillar-row:hover .pillar-row__icon {
    color: var(--color-accent);
    transform: scale(1.08);
  }

  .pillar-row__text {
    flex: 1;
    min-width: 0;
  }

  .pillar-row__text h3 {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--size-3);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .pillar-row--start .pillar-row__text h3 {
    font-size: var(--size-4);
  }

  .pillar-row__badge {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-000);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-sm);
    padding: 2px var(--space-2);
  }

  .pillar-row:hover .pillar-row__text h3 {
    color: var(--color-accent);
  }

  .pillar-row__text p {
    color: var(--color-ink-soft);
    margin: var(--space-2) 0 0;
    max-width: 56ch;
  }

  .pillar-row__cta {
    flex-shrink: 0;
    display: none;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    color: var(--color-accent-cool);
  }

  .pillar-row__cta svg {
    width: 16px;
    height: 16px;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .pillar-row:hover .pillar-row__cta svg {
    transform: translateX(3px);
  }

  .picks-list {
    margin-top: var(--space-6);
  }

  .tools-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .tools-card {
    display: block;
    padding: var(--space-6);
    border-top: 3px solid var(--color-accent);
    background: var(--color-bg-raised);
    text-decoration: none;
    color: var(--color-ink);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out);
  }

  .tools-card:nth-child(2) {
    border-top-color: var(--color-accent-cool);
  }

  .tools-card:hover {
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .tools-card__icon {
    width: 28px;
    height: 28px;
    color: var(--color-ink-faint);
    margin-bottom: var(--space-4);
  }

  .tools-card h3 {
    font-size: var(--size-2);
    margin-bottom: var(--space-2);
  }

  .tools-card p {
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    margin: 0;
  }

  .browse-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--space-6);
    margin-top: var(--space-6);
  }

  .browse-column h3 {
    font-size: var(--size-1);
  }

  .browse-column h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  .browse-column ul {
    list-style: none;
    margin: var(--space-3) 0 0;
    padding: 0;
    display: grid;
    gap: var(--space-2);
  }

  .browse-column a {
    font-size: var(--size-0);
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .browse-column a:hover {
    color: var(--color-accent);
  }

  .about-teaser p {
    color: var(--color-ink-soft);
    max-width: 62ch;
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .pillar-row__cta {
      display: inline-flex;
    }
  }

  @media (max-width: 960px) {
    .hero__inner {
      grid-template-columns: 1fr;
    }

    .browse-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .tools-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .browse-grid {
      grid-template-columns: 1fr;
    }

    .pillar-row {
      flex-wrap: wrap;
    }
  }
</style>
