---
export interface Props {
  kind?: 'tip' | 'mistake' | 'warning';
  label?: string;
}
const { kind = 'tip', label } = Astro.props;
const defaults: Record<string, string> = {
  tip: 'Good to know',
  mistake: 'Common mistake',
  warning: 'Watch out',
};
const heading = label ?? defaults[kind];
---

<aside class:list={['callout', `callout--${kind}`]}>
  <div class="callout__icon" aria-hidden="true">
    {
      kind === 'tip' ? (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 18h6" />
          <path d="M10 22h4" />
          <path d="M12 2a6 6 0 0 0-4 10.5c.6.55 1 1.36 1 2.24V16h6v-1.26c0-.88.4-1.69 1-2.24A6 6 0 0 0 12 2Z" />
        </svg>
      ) : (
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M10.29 3.86 1.82 18a1.5 1.5 0 0 0 1.29 2.25h17.78A1.5 1.5 0 0 0 22.18 18L13.71 3.86a1.5 1.5 0 0 0-2.42 0Z" />
          <path d="M12 9v4" />
          <path d="M12 17h.01" />
        </svg>
      )
    }
  </div>
  <div class="callout__content">
    <p class="callout__label">{heading}</p>
    <div class="callout__body">
      <slot />
    </div>
  </div>
</aside>

<style>
  .callout {
    display: flex;
    gap: var(--space-4);
    background: var(--color-accent-cool-soft);
    padding: var(--space-5);
    border-radius: var(--radius-md);
    margin-block: var(--space-6);
  }

  .callout--mistake,
  .callout--warning {
    background: var(--color-warn-bg);
  }

  .callout__icon {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    color: var(--color-accent-cool);
  }

  .callout--mistake .callout__icon,
  .callout--warning .callout__icon {
    color: var(--color-warn-ink);
  }

  .callout__icon svg {
    width: 100%;
    height: 100%;
  }

  .callout__content {
    min-width: 0;
  }

  .callout__label {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 110%;
    font-size: var(--size-1);
    margin: 0 0 var(--space-2);
    color: var(--color-accent-cool);
  }

  .callout--mistake .callout__label,
  .callout--warning .callout__label {
    color: var(--color-warn-ink);
  }

  .callout__body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
