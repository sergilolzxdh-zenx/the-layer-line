---
import type { CollectionEntry } from 'astro:content';

export interface Props {
  article: CollectionEntry<'articles'>;
}
const { article } = Astro.props;
const typeLabels: Record<string, string> = {
  guide: 'Guide',
  'how-to': 'How-to',
  troubleshooting: 'Troubleshooting',
  comparison: 'Comparison',
  reference: 'Reference',
};
---

<a class="article-row" href={`/${article.id}/`}>
  <div class="article-row__text">
    <h3>{article.data.title}</h3>
    <p class="article-row__desc">{article.data.description}</p>
  </div>
  <div class="article-row__meta">
    <span class="article-row__type">{typeLabels[article.data.pageType]}</span>
    <svg class="article-row__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M5 12h14" />
      <path d="m13 6 6 6-6 6" />
    </svg>
  </div>
</a>

<style>
  .article-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-5);
    padding-block: var(--space-5);
    border-top: var(--border-hair);
    text-decoration: none;
    color: var(--color-ink);
  }

  .article-row:last-child {
    border-bottom: var(--border-hair);
  }

  .article-row__text {
    min-width: 0;
  }

  .article-row h3 {
    font-size: var(--size-2);
    transition: color var(--duration-fast) var(--ease-out);
  }

  .article-row:hover h3 {
    color: var(--color-accent);
  }

  .article-row__desc {
    color: var(--color-ink-soft);
    font-size: var(--size-0);
    margin: var(--space-2) 0 0;
    max-width: 56ch;
  }

  .article-row__meta {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding-top: var(--space-1);
  }

  .article-row__type {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    letter-spacing: 0.02em;
    color: var(--color-accent-cool);
    white-space: nowrap;
  }

  .article-row__arrow {
    width: 18px;
    height: 18px;
    color: var(--color-ink-faint);
    transform: translateX(0);
    transition: transform var(--duration-fast) var(--ease-out), color var(--duration-fast) var(--ease-out);
  }

  .article-row:hover .article-row__arrow {
    color: var(--color-accent);
    transform: translateX(3px);
  }

  @media (max-width: 560px) {
    .article-row {
      flex-direction: column;
      gap: var(--space-2);
    }

    .article-row__meta {
      padding-top: 0;
    }
  }
</style>
