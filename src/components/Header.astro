---
import Logo from './Logo.astro';
import { NAV_LINKS } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<header class="site-header" id="site-header">
  <div class="container site-header__inner">
    <div class="site-header__brand">
      <Logo />
      <span class="site-header__badge">Field manual</span>
    </div>
    <button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav">
      <span class="visually-hidden">Menu</span>
      <span class="nav-toggle__bars" aria-hidden="true"></span>
    </button>
    <nav id="primary-nav" class="primary-nav" aria-label="Primary">
      <ul>
        {
          NAV_LINKS.map((link) => (
            <li>
              <a href={link.href} aria-current={currentPath.startsWith(link.href) ? 'page' : undefined}>
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <a class="site-header__cta" href="/tools/print-problem-diagnostic/">Diagnose a print</a>
    </nav>
  </div>
</header>

<script>
  function setupHeader() {
    const toggle = document.getElementById('nav-toggle');
    const nav = document.getElementById('primary-nav');
    const header = document.getElementById('site-header');

    toggle?.addEventListener('click', () => {
      const isOpen = nav?.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(Boolean(isOpen)));
    });

    nav?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        nav.classList.remove('is-open');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });

    const onScroll = () => {
      header?.classList.toggle('is-scrolled', window.scrollY > 4);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', setupHeader);
</script>

<style>
  .site-header {
    border-bottom: 1px solid transparent;
    background: var(--color-bg);
    position: sticky;
    top: 0;
    z-index: 40;
    transition: border-color var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--color-line);
    box-shadow: var(--shadow-sm);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    gap: var(--space-4);
  }

  .site-header__brand {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
  }

  .site-header__badge {
    font-family: var(--font-mono);
    font-size: var(--size-000);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
    border: var(--border-hair-strong);
    border-radius: var(--radius-sm);
    padding: 3px var(--space-2);
    white-space: nowrap;
  }

  .primary-nav {
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .primary-nav ul {
    display: flex;
    gap: var(--space-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .primary-nav ul a {
    position: relative;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: var(--size-00);
    letter-spacing: 0.02em;
    text-decoration: none;
    color: var(--color-ink-soft);
    padding-bottom: 2px;
    transition: color var(--duration-fast) var(--ease-out);
  }

  .primary-nav ul a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 100%;
    bottom: -2px;
    height: 2px;
    background: var(--color-accent);
    transition: right var(--duration-fast) var(--ease-out);
  }

  .primary-nav ul a:hover {
    color: var(--color-ink);
  }

  .primary-nav ul a:hover::after,
  .primary-nav ul a[aria-current='page']::after {
    right: 0;
  }

  .primary-nav ul a[aria-current='page'] {
    color: var(--color-ink);
  }

  .site-header__cta {
    flex-shrink: 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--size-00);
    letter-spacing: 0.01em;
    text-decoration: none;
    color: var(--color-accent-ink);
    background: var(--color-ink);
    border: 1px solid var(--color-ink);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-4);
    transition: background var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out), transform var(--duration-instant) var(--ease-out);
  }

  .site-header__cta:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
  }

  .site-header__cta:active {
    transform: scale(var(--scale-press));
  }

  .nav-toggle {
    display: none;
    background: none;
    border: var(--border-hair-strong);
    border-radius: var(--radius-sm);
    padding: var(--space-2) var(--space-3);
    cursor: pointer;
    transition: transform var(--duration-instant) var(--ease-out), border-color var(--duration-fast) var(--ease-out);
  }

  .nav-toggle:active {
    transform: scale(var(--scale-press));
  }

  .nav-toggle:hover {
    border-color: var(--color-ink);
  }

  .nav-toggle__bars,
  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--color-ink);
    position: relative;
  }

  .nav-toggle__bars::before,
  .nav-toggle__bars::after {
    content: '';
    position: absolute;
    transition: transform var(--duration-fast) var(--ease-out), top var(--duration-fast) var(--ease-out);
  }

  .nav-toggle__bars::before {
    top: -6px;
  }

  .nav-toggle__bars::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 980px) {
    .site-header__badge {
      display: none;
    }
  }

  @media (max-width: 800px) {
    .nav-toggle {
      display: inline-flex;
      align-items: center;
    }

    .primary-nav {
      position: absolute;
      inset-inline: 0;
      top: 100%;
      flex-direction: column;
      align-items: stretch;
      background: var(--color-bg);
      border-bottom: var(--border-hair);
      padding: var(--space-4) var(--space-5) var(--space-6);
      opacity: 0;
      visibility: hidden;
      transform: translateY(-6px);
      pointer-events: none;
      transition: opacity var(--duration-fast) var(--ease-out), transform var(--duration-fast) var(--ease-out), visibility 0s linear var(--duration-fast);
    }

    .primary-nav.is-open {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
      transition-delay: 0s;
    }

    .primary-nav ul {
      flex-direction: column;
      gap: var(--space-4);
    }

    .primary-nav ul a::after {
      display: none;
    }

    .site-header__cta {
      margin-top: var(--space-5);
      text-align: center;
    }

    .site-header__badge {
      display: none;
    }
  }
</style>
