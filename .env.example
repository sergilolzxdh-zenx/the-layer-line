# Copy to .env and fill in once you have real values. Never commit .env.
# All variables are optional — the site builds and runs fine without them.

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave unset to disable analytics.
PUBLIC_GA_ID=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX). Not wired into any
# component yet — see MONETIZATION.md for how to add real ad units once the
# site is approved. Reserved here so the variable name is settled in advance.
PUBLIC_ADSENSE_CLIENT=
